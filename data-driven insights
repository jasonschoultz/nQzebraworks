    <script>
        // Update page numbers for print
        window.addEventListener('beforeprint', function() {
            // Page 1: Client Info cards, Page 2: ROI Analysis, Page 3: Recovery & Revenue Analysis
            const estimatedPages = 3;
            document.getElementById('totalPages').textContent = estimatedPages;
        });

        // Validation function for mandatory fields
        function validateAndPrint() {
            const companyName = document.getElementById('companyName').value.trim();
            const contactName = document.getElementById('contactName').value.trim();
            const emailAddress = document.getElementById('emailAddress').value.trim();

            if (!companyName) {
                alert('Please enter Company Name');
                document.getElementById('companyName').focus();
                return;
            }

            if (!contactName) {
                alert('Please enter Contact Name');
                document.getElementById('contactName').focus();
                return;
            }

            if (!emailAddress) {
                alert('Please enter Email Address');
                document.getElementById('emailAddress').focus();
                return;
            }

            // Basic email validation
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(emailAddress)) {
                alert('Please enter a valid Email Address');
                document.getElementById('emailAddress').focus();
                return;
            }

            // If all validations pass, trigger print
            window.print();
        }

        // Calculation Functions
        function formatNumber(value) {
            return Math.round(value).toLocaleString('en-US');
        }

        function formatCurrency(value) {
            const rounded = Math.round(value);
            return 'R ' + rounded.toLocaleString('en-US');
        }

        function formatDecimal(value, decimals = 2) {
            return 'R ' + value.toFixed(decimals);
        }

        function formatPercent(value) {
            return Math.round(value * 100) + '%';
        }

        function calculate() {
            // Get input values
            const boxesPerMonth = parseFloat(document.getElementById('boxesPerMonth').value) || 0;
            const telephone = parseFloat(document.getElementById('telephone').value) || 0;
            const costPerBox = parseFloat(document.getElementById('costPerBox').value) || 0;
            const rentalCost = parseFloat(document.getElementById('rentalCost').value) || 0;
            const billingUsers = parseFloat(document.getElementById('billingUsers').value) || 0;
            const nonBillingUsers = parseFloat(document.getElementById('nonBillingUsers').value) || 0;
            const phoneRateHour = parseFloat(document.getElementById('phoneRateHour').value) || 1500;

            // Sync the phone rate hour display
            document.getElementById('phoneRateHourDisplay').textContent = formatCurrency(phoneRateHour);

            // Calculate totals
            const totalStaff = billingUsers + nonBillingUsers;
            const recoveryRatio = totalStaff > 0 ? billingUsers / totalStaff : 0;

            // Update staff section
            document.getElementById('totalStaff').value = totalStaff;
            document.getElementById('recoveryRatio').textContent = formatPercent(recoveryRatio);
            document.getElementById('actualBillingPercent').value = Math.round(recoveryRatio * 100);

            // Calculate consumption costs
            const pagesPerBox = 2500;
            const pagesPerMonth = boxesPerMonth * pagesPerBox;
            const pagesPerAnnum = pagesPerMonth * 12;
            const paperCostMonth = boxesPerMonth * costPerBox;
            const costPerPage = costPerBox / pagesPerBox;
            const electricityCost = 0.07;
            const floorRental = 0.05;
            const trueCost = costPerPage + rentalCost + electricityCost + floorRental;
            const totalCostMonth = trueCost * pagesPerMonth;
            const volumeScans = pagesPerMonth * 0.4;
            const volumeEmails = 40 * billingUsers * 22;
            const phoneRateMinute = phoneRateHour / 60;
            const volumeCalls = telephone / 0.6;

            // Update consumption costs display
            document.getElementById('pagesPerMonth').textContent = formatNumber(pagesPerMonth);
            document.getElementById('pagesPerAnnum').textContent = formatNumber(pagesPerAnnum);
            document.getElementById('paperCostMonth').textContent = formatCurrency(paperCostMonth);
            document.getElementById('costPerPage').textContent = formatDecimal(costPerPage);
            document.getElementById('rentalDisplay').textContent = formatDecimal(rentalCost);
            document.getElementById('trueCost').textContent = formatDecimal(trueCost);
            document.getElementById('totalCostMonth').textContent = formatCurrency(totalCostMonth);
            document.getElementById('volumeScans').textContent = formatNumber(volumeScans);
            document.getElementById('volumeEmails').textContent = formatNumber(volumeEmails);
            document.getElementById('actualTelCost').textContent = formatCurrency(telephone);
            document.getElementById('volumeCalls').textContent = formatNumber(volumeCalls);
            document.getElementById('phoneRateMinuteDisplay').textContent = formatDecimal(phoneRateMinute);
            
            // Update rec_phone input value with the phone rate per minute
            document.getElementById('rec_phone').value = phoneRateMinute.toFixed(2);

            // Update monthly volumes for calculated fields
            document.getElementById('vol_copy').textContent = formatNumber(pagesPerMonth);
            document.getElementById('vol_phone').textContent = formatNumber(volumeCalls);
            document.getElementById('vol_scans').textContent = formatNumber(volumeScans);
            document.getElementById('vol_emails').textContent = formatNumber(volumeEmails);

            // Calculate billable volumes and revenue
            calculateRevenue();
        }

        function calculateRevenue() {
            const items = ['copy', 'colour', 'phone', 'scans', 'emails', 'mobile'];
            
            // Get the billing percentages
            const lowEndPercent = (parseFloat(document.getElementById('lowEndPercent').value) || 10) / 100;
            const midRangePercent = (parseFloat(document.getElementById('midRangePercent').value) || 25) / 100;
            const billingUsers = parseFloat(document.getElementById('billingUsers').value) || 0;
            const totalStaff = parseFloat(document.getElementById('totalStaff').value) || 1;
            const actualRatio = billingUsers / totalStaff;
            
            items.forEach(item => {
                const volElement = document.getElementById(`vol_${item}`);
                let volume = 0;
                
                if (volElement.tagName === 'INPUT') {
                    volume = parseFloat(volElement.value) || 0;
                } else {
                    volume = parseFloat(volElement.textContent.replace(/,/g, '')) || 0;
                }

                const shrinkage = (parseFloat(document.getElementById(`shrink_${item}`).value) || 0) / 100; // Convert percentage to decimal
                
                // Get recovery charge from input value
                const recovery = parseFloat(document.getElementById(`rec_${item}`).value) || 0;
                
                const billableVolume = Math.round(volume - (volume * shrinkage)); // Round to whole number
                document.getElementById(`bill_${item}`).textContent = formatNumber(billableVolume);

                // Calculate revenue for all three scenarios using editable percentages
                const revLow = billableVolume * recovery * lowEndPercent;
                const revMid = billableVolume * recovery * midRangePercent;
                const revAct = billableVolume * recovery * actualRatio;

                document.getElementById(`rev_${item}_low`).textContent = formatCurrency(revLow);
                document.getElementById(`rev_${item}_mid`).textContent = formatCurrency(revMid);
                document.getElementById(`rev_${item}_act`).textContent = formatCurrency(revAct);
            });

            // Calculate totals
            let totalLow = 0, totalMid = 0, totalAct = 0;
            items.forEach(item => {
                totalLow += parseFloat(document.getElementById(`rev_${item}_low`).textContent.replace(/[R ,]/g, '')) || 0;
                totalMid += parseFloat(document.getElementById(`rev_${item}_mid`).textContent.replace(/[R ,]/g, '')) || 0;
                totalAct += parseFloat(document.getElementById(`rev_${item}_act`).textContent.replace(/[R ,]/g, '')) || 0;
            });

            document.getElementById('total_low').textContent = formatCurrency(totalLow);
            document.getElementById('total_mid').textContent = formatCurrency(totalMid);
            document.getElementById('total_act').textContent = formatCurrency(totalAct);

            document.getElementById('annual_low').textContent = formatCurrency(totalLow * 12);
            document.getElementById('annual_mid').textContent = formatCurrency(totalMid * 12);
            document.getElementById('annual_act').textContent = formatCurrency(totalAct * 12);
        }

        // Event listeners for all inputs
        document.querySelectorAll('input[type="number"]:not([disabled])').forEach(input => {
            input.addEventListener('input', calculate);
        });

        // Event listeners for revenue percentage inputs
        document.getElementById('lowEndPercent').addEventListener('input', calculate);
        document.getElementById('midRangePercent').addEventListener('input', calculate);

        // Initial calculation
        calculate();
    </script>
