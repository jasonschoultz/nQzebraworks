<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegalTech ROI Calculator</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #002248;
            --secondary-pink: #ec26c1;
            --bright-orange: #ff6b35;
            --light-bg: #f8f9fa;
            --white: #ffffff;
            --border-color: #e0e4e8;
            --shadow: 0 2px 8px rgba(0, 34, 72, 0.08);
            --shadow-lg: 0 8px 24px rgba(0, 34, 72, 0.12);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            color: var(--primary-blue);
            line-height: 1.6;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
            animation: fadeInDown 0.6s ease-out;
        }

        .header h1 {
            font-size: 3rem;
            font-weight: 700;
            color: var(--primary-blue);
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-pink) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header p {
            font-size: 1.1rem;
            color: #6c757d;
            font-weight: 400;
        }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .card {
            background: var(--white);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease-out;
            animation-fill-mode: both;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .card h2 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--secondary-pink);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-weight: 500;
            color: var(--primary-blue);
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: var(--white);
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--secondary-pink);
            box-shadow: 0 0 0 3px rgba(236, 38, 193, 0.1);
        }

        .form-group input:disabled {
            background: var(--light-bg);
            cursor: not-allowed;
            color: #6c757d;
            font-weight: 600;
        }

        .metric-display {
            background: var(--bright-orange);
            color: var(--white);
            padding: 2rem;
            border-radius: 12px;
            text-align: center;
            margin-top: 1rem;
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
        }

        .metric-display .label {
            font-size: 0.9rem;
            font-weight: 500;
            opacity: 0.95;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .metric-display .value {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1;
        }

        .info-text {
            font-size: 0.85rem;
            color: #6c757d;
            font-style: italic;
            margin-top: 0.25rem;
        }

        .section-divider {
            margin: 3rem 0;
            border: none;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--secondary-pink), transparent);
        }

        .roi-section {
            background: var(--white);
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: var(--shadow);
            animation: fadeInUp 0.8s ease-out;
            animation-fill-mode: both;
            animation-delay: 0.2s;
        }

        .roi-section h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-blue);
            margin-bottom: 2rem;
            text-align: center;
        }

        .table-container {
            overflow-x: auto;
            margin-bottom: 2rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
        }

        th {
            background: linear-gradient(135deg, var(--primary-blue) 0%, #4a1a5c 70%, #d946a6 100%);
            color: var(--white);
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            white-space: nowrap;
        }

        td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        td:nth-child(2) {
            text-align: right;
        }

        td:nth-child(3) {
            text-align: left;
        }

        td:nth-child(4),
        td:nth-child(5) {
            text-align: right;
        }

        th:nth-child(1) {
            text-align: left;
        }

        th:nth-child(2) {
            text-align: right;
        }

        th:nth-child(3) {
            text-align: left;
        }

        th:nth-child(4),
        th:nth-child(5) {
            text-align: right;
        }

        tr:hover {
            background: #f8f9fa;
        }
        
        .orange-row:hover,
        .light-orange-row:hover,
        .highlight-row:hover {
            background: inherit !important;
        }

        .orange-row:hover td,
        .light-orange-row:hover td,
        .highlight-row:hover td {
            background: inherit !important;
        }

        td input {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
        }

        td input.percent-input {
            text-align: right;
            width: 60px;
            display: inline-block;
        }

        td input.percent-input::after {
            content: '%';
        }

        .percent-symbol {
            margin-left: 4px;
            color: var(--primary-blue);
            font-weight: 500;
        }

        td input:focus {
            outline: none;
            border-color: var(--secondary-pink);
        }

        .readonly-cell {
            background: var(--light-bg);
            font-weight: 600;
            color: var(--primary-blue);
        }

        .highlight-row {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            color: var(--primary-blue);
            border-left: 4px solid var(--secondary-pink);
        }

        .highlight-row td {
            border-bottom: 2px solid var(--secondary-pink);
            color: var(--primary-blue);
        }

        .highlight-row input {
            background: white;
            border: 2px solid var(--primary-blue);
            color: var(--primary-blue);
            font-weight: 600;
            padding: 0.5rem;
            border-radius: 6px;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            width: 100%;
        }

        .highlight-row input:focus {
            outline: none;
            border-color: var(--secondary-pink);
            box-shadow: 0 0 0 3px rgba(236, 38, 193, 0.1);
        }

        .highlight-row .readonly-cell {
            background: transparent;
            color: var(--primary-blue);
        }

        .orange-row {
            background: linear-gradient(135deg, var(--bright-orange) 0%, #ff8c5a 100%);
            color: var(--white);
        }

        .orange-row td {
            border-bottom: 2px solid #ff8c5a;
        }

        .orange-row input {
            background: white;
            border: 2px solid var(--primary-blue);
            color: var(--primary-blue);
            font-weight: 600;
            padding: 0.5rem;
            border-radius: 6px;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            width: 100%;
            position: relative;
            z-index: 10;
            pointer-events: auto;
            cursor: text;
        }

        .orange-row input:focus {
            outline: none;
            border-color: var(--secondary-pink);
            box-shadow: 0 0 0 3px rgba(236, 38, 193, 0.1);
        }

        .orange-row .readonly-cell {
            background: transparent;
            color: var(--white);
        }

        .light-orange-row {
            background: linear-gradient(135deg, #ffb380 0%, #ffc999 100%);
            color: var(--primary-blue);
            font-weight: 600;
        }

        .light-orange-row td {
            border-bottom: 2px solid #ffb380;
        }

        .light-orange-row input {
            background: white !important;
            border: 2px solid var(--primary-blue) !important;
            color: var(--primary-blue) !important;
            font-weight: 600 !important;
            pointer-events: auto !important;
            cursor: text !important;
        }

        .light-orange-row input:focus {
            outline: none !important;
            border-color: var(--secondary-pink) !important;
            box-shadow: 0 0 0 3px rgba(236, 38, 193, 0.1) !important;
        }

        .editable-orange-input {
            background: white !important;
            border: 2px solid var(--primary-blue) !important;
            color: var(--primary-blue) !important;
            font-weight: 600 !important;
            width: 100% !important;
            padding: 0.5rem !important;
            border-radius: 6px !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 0.9rem !important;
        }

        .revenue-table {
            margin-top: 2rem;
        }

        .revenue-table th:nth-child(1),
        .revenue-table td:nth-child(1) {
            width: 35%;
        }

        .revenue-table th:nth-child(2),
        .revenue-table td:nth-child(2),
        .revenue-table th:nth-child(3),
        .revenue-table td:nth-child(3),
        .revenue-table th:nth-child(4),
        .revenue-table td:nth-child(4) {
            width: 21.67%;
            text-align: right;
        }

        .total-row {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            color: var(--primary-blue);
            font-weight: 700;
            font-size: 1rem;
            box-shadow: inset 3px 0 0 0 var(--secondary-pink);
        }

        .total-row td {
            border: none;
            padding: 1.25rem 1rem;
            border-bottom: none;
        }

        .total-row td:first-child {
        }

        .total-row td:last-child {
        }

        .total-row td:nth-child(2),
        .total-row td:nth-child(3),
        .total-row td:nth-child(4) {
            text-align: right;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .subsection-header {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            padding: 1rem 1.5rem;
            border-radius: 8px;
            margin: 2rem 0 1rem 0;
            border-left: 4px solid var(--secondary-pink);
        }

        .subsection-header h3 {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--primary-blue);
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 2rem;
            }
            
            .dashboard {
                grid-template-columns: 1fr;
            }
            
            .roi-section {
                padding: 1.5rem;
            }
            
            table {
                font-size: 0.85rem;
            }
            
            th, td {
                padding: 0.5rem;
            }
        }

        .footer {
            background: var(--white);
            padding: 1.5rem 2rem;
            margin-top: 3rem;
            border-top: 2px solid var(--border-color);
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            color: var(--primary-blue);
        }

        .footer-line1 {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .footer-line2 {
            text-align: center;
            color: #6c757d;
        }

        .page-number {
            font-family: 'Poppins', sans-serif;
            font-size: 9pt;
            color: var(--primary-blue);
        }

        .print-button {
            background: linear-gradient(135deg, var(--bright-orange) 0%, #ff8c5a 100%);
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
            transition: all 0.3s ease;
        }

        .print-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(255, 107, 53, 0.4);
        }

        @media print {
            /* Preserve all colors and styles exactly as on screen */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            /* Hide print button */
            .print-button {
                display: none !important;
            }

            /* Page 1: Header + Dashboard cards together */
            .dashboard {
                page-break-after: always !important;
            }

            /* Page 2: ROI Analysis section */
            .roi-section {
                page-break-before: always !important;
                page-break-after: always !important;
            }

            /* Page 3: Revenue tables together */
            .revenue-table:first-of-type {
                page-break-before: always !important;
                page-break-after: avoid !important;
            }

            /* Footer with dynamic page numbers */
            .footer {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                padding: 0.6rem 2rem;
                background: white;
                border-top: 1px solid #ddd;
            }

            .page-number::after {
                content: "Page " counter(page) " of 3";
            }

            .page-number span {
                display: none;
            }

            /* Page settings */
            @page {
                size: A4 portrait;
                margin: 1.5cm 1.5cm 3cm 1.5cm;
            }

            /* Prevent orphaned content */
            h2, h3, .subsection-header {
                page-break-after: avoid !important;
            }

            tr, .card {
                page-break-inside: avoid !important;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>LegalTech ROI Calculator</h1>
            <p>Transform your practice with data-driven insights</p>
        </div>

        <div class="dashboard">
            <!-- Questions Section -->
            <div class="card" style="animation-delay: 0s;">
                <h2>Client Information</h2>
                
                <div class="form-group">
                    <label>Boxes of Paper per Month</label>
                    <input type="number" id="boxesPerMonth" value="10" min="0" step="1">
                </div>

                <div class="form-group">
                    <label>Telephone Costs (Monthly)</label>
                    <input type="number" id="telephone" value="1500" min="0" step="0.01">
                </div>

                <div class="form-group">
                    <label>Cost Per Box</label>
                    <input type="number" id="costPerBox" value="400" min="0" step="0.01">
                </div>

                <div class="form-group">
                    <label>Rental Cost per MFP Device</label>
                    <input type="number" id="rentalCost" value="0.25" min="0" step="0.01">
                </div>

                <div class="form-group">
                    <label>Estimated Number of Copiers</label>
                    <input type="number" id="copiers" value="3" min="0" step="1">
                </div>

                <div class="form-group">
                    <label>Telephone Rate per Hour</label>
                    <input type="number" id="phoneRateHour" value="1500" min="0" step="0.01">
                </div>
            </div>

            <!-- Staff Headcount Section -->
            <div class="card" style="animation-delay: 0.1s;">
                <h2>Staff Head Count</h2>
                
                <div class="form-group">
                    <label>Billing Users</label>
                    <input type="number" id="billingUsers" value="25" min="0" step="1">
                    <p class="info-text">Commercial, Litigation, MVA, Medical</p>
                </div>

                <div class="form-group">
                    <label>Non-Billing Users</label>
                    <input type="number" id="nonBillingUsers" value="6" min="0" step="1">
                    <p class="info-text">Admin, Conveyancing, IT Dept., Filing</p>
                </div>

                <div class="form-group">
                    <label>Total Staff</label>
                    <input type="number" id="totalStaff" value="31" disabled>
                </div>

                <div class="metric-display">
                    <div class="label">Fee Billing Ratio</div>
                    <div class="value" id="recoveryRatio">80.6%</div>
                </div>

                <div class="form-group" style="margin-top: 1.5rem;">
                    <label>Company Name <span style="color: var(--secondary-pink);">*</span></label>
                    <input type="text" id="companyName" placeholder="Enter company name" required>
                </div>

                <div class="form-group">
                    <label>Contact Name <span style="color: var(--secondary-pink);">*</span></label>
                    <input type="text" id="contactName" placeholder="Enter contact name" required>
                </div>

                <div class="form-group">
                    <label>Email Address <span style="color: var(--secondary-pink);">*</span></label>
                    <input type="email" id="emailAddress" placeholder="Enter email address" required>
                </div>
            </div>
        </div>

        <hr class="section-divider">

        <!-- ROI Analysis Section -->
        <div class="roi-section">
            <h2>ROI Analysis</h2>

            <div class="subsection-header">
                <h3>Current Consumption Costs</h3>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Metric</th>
                            <th>Value</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Pages per box</td>
                            <td class="readonly-cell">2,500</td>
                            <td>Standard box capacity</td>
                        </tr>
                        <tr>
                            <td>Pages per Month</td>
                            <td class="readonly-cell" id="pagesPerMonth">25,000</td>
                            <td>Boxes × Pages per box</td>
                        </tr>
                        <tr>
                            <td>Pages per Annum</td>
                            <td class="readonly-cell" id="pagesPerAnnum">300,000</td>
                            <td>Monthly pages × 12</td>
                        </tr>
                        <tr>
                            <td>Cost of Paper Per Month</td>
                            <td class="readonly-cell" id="paperCostMonth">R 4,000</td>
                            <td>Boxes × Cost per box</td>
                        </tr>
                        <tr>
                            <td>Cost of Paper Per Page (Actuals)</td>
                            <td class="readonly-cell" id="costPerPage">R 0.16</td>
                            <td>Cost per box ÷ Pages per box</td>
                        </tr>
                        <tr>
                            <td>Rental Cost per MFP Device</td>
                            <td class="readonly-cell" id="rentalDisplay">R 0.25</td>
                            <td>Average cost per page</td>
                        </tr>
                        <tr>
                            <td>Electricity Cost per MFP Device</td>
                            <td class="readonly-cell">R 0.07</td>
                            <td>Actuals</td>
                        </tr>
                        <tr>
                            <td>Office Floor Rental Space</td>
                            <td class="readonly-cell">R 0.05</td>
                            <td>Per page allocation</td>
                        </tr>
                        <tr class="highlight-row">
                            <td>True Cost Per Print/Copy</td>
                            <td class="readonly-cell" id="trueCost">R 0.53</td>
                            <td>Including rental and maintenance</td>
                        </tr>
                        <tr class="orange-row">
                            <td>Total Cost Per Print/Copy Per Month</td>
                            <td class="readonly-cell" id="totalCostMonth">R 13,250</td>
                            <td>True cost × Monthly pages</td>
                        </tr>
                        <tr>
                            <td>Volume of Scans</td>
                            <td class="readonly-cell" id="volumeScans">10,000</td>
                            <td>40% of monthly pages</td>
                        </tr>
                        <tr>
                            <td>Volume of eMails</td>
                            <td class="readonly-cell" id="volumeEmails">22,000</td>
                            <td>40 per day × Billing users × 22 days</td>
                        </tr>
                        <tr>
                            <td>Telephone Calls (Rate/Hour)</td>
                            <td class="readonly-cell" id="phoneRateHourDisplay">R 1,500</td>
                            <td>Hourly rate</td>
                        </tr>
                        <tr>
                            <td>Telephone Calls (Rate/Minute)</td>
                            <td class="readonly-cell" id="phoneRateMinuteDisplay">R 25.00</td>
                            <td>Rate per hour ÷ 60</td>
                        </tr>
                        <tr>
                            <td>Actual Telephone Call Costs</td>
                            <td class="readonly-cell" id="actualTelCost">R 1,500</td>
                            <td>Clients Input</td>
                        </tr>
                        <tr>
                            <td>Volume of Telephone Calls</td>
                            <td class="readonly-cell" id="volumeCalls">2,500</td>
                            <td>40 cents per minute</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection-header">
                <h3>Recovery Analysis</h3>
            </div>

            <div class="table-container revenue-table">
                <table>
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Monthly Volume</th>
                            <th>Shrinkage Costs</th>
                            <th>Billable Volumes</th>
                            <th>Recovery Charges</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Copy & Print</td>
                            <td class="readonly-cell" id="vol_copy">25,000</td>
                            <td><input type="number" class="percent-input" id="shrink_copy" value="15" min="0" max="100" step="1" style="text-align: right;"> %</td>
                            <td class="readonly-cell" id="bill_copy">21,250</td>
                            <td><input type="number" id="rec_copy" value="7" min="0" step="0.01" style="text-align: right;"></td>
                        </tr>
                        <tr>
                            <td>Colour Print</td>
                            <td><input type="number" id="vol_colour" value="0" min="0" step="1" style="text-align: right;"></td>
                            <td><input type="number" class="percent-input" id="shrink_colour" value="10" min="0" max="100" step="1" style="text-align: right;"> %</td>
                            <td class="readonly-cell" id="bill_colour">0</td>
                            <td><input type="number" id="rec_colour" value="16.5" min="0" step="0.01" style="text-align: right;"></td>
                        </tr>
                        <tr>
                            <td>Landline & VoIP Phone</td>
                            <td class="readonly-cell" id="vol_phone">62,500</td>
